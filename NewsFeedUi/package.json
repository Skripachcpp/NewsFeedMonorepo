{
  "name": "NewsFeedUi",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tsc": "nuxt typecheck",
    "api": "node scripts/generate-api.js",
    "format": "prettier --write .",
    "mf:build:shared": "npm run build --prefix ../packages/shared",
    "mf:install": "npm run mf:build:shared && npm install --prefix ../NewsFeedUiAuth && npm install --prefix ../NewsFeedUiNews",
    "mf:dev": "npx concurrently -n auth,news,host \"npm run dev --prefix ../NewsFeedUiAuth\" \"npm run dev --prefix ../NewsFeedUiNews\" \"npm run dev\"",
    "mf:dev:host": "npm run dev",
    "mf:dev:auth": "npm run dev --prefix ../NewsFeedUiAuth",
    "mf:dev:news": "npm run dev --prefix ../NewsFeedUiNews"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "@types/node": "^24.10.1",
    "nuxt": "^4.2.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.3.6",
    "prettier": "^3.4.2"
  }
}
